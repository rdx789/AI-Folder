# AWS SDK credentials can also come from your AWS profile or host environment.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
MAYA_EMBED_DIM=1024
# Live retrieval requires an existing HTTPS OpenSearch endpoint.
OPENSEARCH_ENDPOINT=
# Alternative: resolve an existing Serverless collection by name, as in Lesson 7.
OPENSEARCH_COLLECTION=
OPENSEARCH_SERVICE=aoss
MAYA_OPENSEARCH_INDEX=maya-evidence-v1
# Optional separate credentials for OpenSearch; leave unset to use default AWS credentials.
# OPENSEARCH_AWS_ACCESS_KEY_ID=
# OPENSEARCH_AWS_SECRET_ACCESS_KEY=
# OPENSEARCH_AWS_SESSION_TOKEN=
# NovaOps dataset root (employment/, policies/, it_kb/, memos/, contracts/, database/).
# Absolute, or relative to this project folder. Default: data
# (NOVAOPS_DATA_ROOT is still honoured as a legacy alias when DATA_PATH is unset.)
DATA_PATH=data

# Local read-only MCP server; separate from lesson server port 9877.
MAYA_MCP_PORT=9878
